# Regras de dependência da arquitetura hexagonal (ver CLAUDE.md e ADR 0001).
# Ao criar um adapter novo: adicione o módulo em root_packages e em todos os contratos
# que listam adapters (core-isolado, adapters-isolados, testkit-so-core, adapters-independentes).
[importlinter]
root_packages =
    dengcode_core
    dengcode_engine
    dengcode_cli
    dengcode_testkit
    dengcode_adapter_local_fs
    dengcode_adapter_llm_anthropic
    dengcode_adapter_llm_openai
    dengcode_adapter_llm_ollama
    dengcode_adapter_duckdb
    dengcode_adapter_postgres
    dengcode_adapter_minio
    dengcode_adapter_dbt
    dengcode_adapter_kafka
    dengcode_adapter_memory_sqlite
    dengcode_adapter_embedding_local
    dengcode_adapter_airflow
    dengcode_adapter_trino
    dengcode_adapter_iceberg_rest
include_external_packages = True

[importlinter:contract:core-isolado]
name = core não importa engine, CLI, testkit nem adapters
type = forbidden
source_modules =
    dengcode_core
forbidden_modules =
    dengcode_engine
    dengcode_cli
    dengcode_testkit
    dengcode_adapter_local_fs
    dengcode_adapter_llm_anthropic
    dengcode_adapter_llm_openai
    dengcode_adapter_llm_ollama
    dengcode_adapter_duckdb
    dengcode_adapter_postgres
    dengcode_adapter_minio
    dengcode_adapter_dbt
    dengcode_adapter_kafka
    dengcode_adapter_memory_sqlite
    dengcode_adapter_embedding_local
    dengcode_adapter_airflow
    dengcode_adapter_trino
    dengcode_adapter_iceberg_rest

[importlinter:contract:core-sem-sdks]
name = core não importa SDKs de nuvem, de LLM nem engines de dados
type = forbidden
source_modules =
    dengcode_core
forbidden_modules =
    boto3
    botocore
    aioboto3
    obstore
    azure
    google
    databricks
    anthropic
    openai
    httpx
    httpx2
    duckdb
    psycopg
    aiokafka
    fastembed
    sqlite_vec

[importlinter:contract:adapters-isolados]
name = adapters não importam engine nem CLI
type = forbidden
source_modules =
    dengcode_adapter_local_fs
    dengcode_adapter_llm_anthropic
    dengcode_adapter_llm_openai
    dengcode_adapter_llm_ollama
    dengcode_adapter_duckdb
    dengcode_adapter_postgres
    dengcode_adapter_minio
    dengcode_adapter_dbt
    dengcode_adapter_kafka
    dengcode_adapter_memory_sqlite
    dengcode_adapter_embedding_local
    dengcode_adapter_airflow
    dengcode_adapter_trino
    dengcode_adapter_iceberg_rest
forbidden_modules =
    dengcode_engine
    dengcode_cli

[importlinter:contract:engine-sem-cli]
name = engine não importa a CLI
type = forbidden
source_modules =
    dengcode_engine
forbidden_modules =
    dengcode_cli

[importlinter:contract:testkit-so-core]
name = testkit só depende do core
type = forbidden
source_modules =
    dengcode_testkit
forbidden_modules =
    dengcode_engine
    dengcode_cli
    dengcode_adapter_local_fs
    dengcode_adapter_llm_anthropic
    dengcode_adapter_llm_openai
    dengcode_adapter_llm_ollama
    dengcode_adapter_duckdb
    dengcode_adapter_postgres
    dengcode_adapter_minio
    dengcode_adapter_dbt
    dengcode_adapter_kafka
    dengcode_adapter_memory_sqlite
    dengcode_adapter_embedding_local
    dengcode_adapter_airflow
    dengcode_adapter_trino
    dengcode_adapter_iceberg_rest

[importlinter:contract:adapters-independentes]
name = adapters não importam uns aos outros
type = independence
modules =
    dengcode_adapter_local_fs
    dengcode_adapter_llm_anthropic
    dengcode_adapter_llm_openai
    dengcode_adapter_llm_ollama
    dengcode_adapter_duckdb
    dengcode_adapter_postgres
    dengcode_adapter_minio
    dengcode_adapter_dbt
    dengcode_adapter_kafka
    dengcode_adapter_memory_sqlite
    dengcode_adapter_embedding_local
    dengcode_adapter_airflow
    dengcode_adapter_trino
    dengcode_adapter_iceberg_rest
